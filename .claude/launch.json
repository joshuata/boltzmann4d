{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "pnpm dev --port \"${PORT:-5173}\" --strictPort"],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "preview",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "pnpm build && pnpm preview --port \"${PORT:-4173}\" --strictPort"],
      "port": 4173,
      "autoPort": true
    }
  ]
}
