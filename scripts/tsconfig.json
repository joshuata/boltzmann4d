{
  // Node-side scripts (profiling, tooling). Separate from the app's tsconfig so that
  // src/ never sees Node types: src/sim, src/io and friends must stay browser-safe.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "types": ["node", "vite/client"],
    "noEmit": true
  },
  "include": ["**/*.ts", "../src/**/*.ts"],
  "exclude": ["../src/**/*.svelte.ts", "../src/**/*.test.ts", "../src/**/*.bench.ts"]
}
