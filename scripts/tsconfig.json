{
  // Node-side scripts (profiling, benchmarks, reports). They import the engine package,
  // which has its own tsconfig without Node types, so the engine stays browser-safe.
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["es2022"],
    "types": ["node", "vite/client"]
  },
  "include": ["**/*.ts"]
}
